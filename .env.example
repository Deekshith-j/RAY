# Database Settings
DATABASE_URL=sqlite+aiosqlite:///./ray.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+asyncpg://ray_user:ray_password@localhost:5432/ray_db

# Redis / Queue Settings
REDIS_URL=redis://localhost:6379/0

# Razorpay Test Mode Credentials (NEVER USE LIVE KEYS)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=webhook_secret_placeholder

# LLM & Agent Settings
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
MAX_AGENT_STEPS=12
MODEL_VERSION=ray-recov-v1-production
FEATURE_SCHEMA_VERSION=v1.0

# Financial Policy Thresholds
HIGH_VALUE_THRESHOLD=50000.0
MAX_AUTO_RETRY_ATTEMPTS=1
MAX_AUTO_RETRY_AMOUNT=10000.0

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
